; Electron Forge 8's terminal UI (ink) declares React 19 as a peer, while the
; app uses React 18. Don't let npm install a second React for the build tool.
legacy-peer-deps=true

; npm 12 refuses git dependencies unless opted in. The castlabs Electron build
; is one, and Electron Forge pulls in @electron/node-gyp from git as well.
allow-git=all
