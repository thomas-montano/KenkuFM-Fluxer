; Kenku FM was originally a yarn project; several of its legacy dev deps
; (worklet-loader, etc.) declare outdated peer ranges that npm enforces
; strictly. Match yarn's behavior so `npm install` works out of the box.
legacy-peer-deps=true

; npm 12 refuses git dependencies unless opted in. The castlabs Electron build
; is one, and Electron Forge pulls in @electron/node-gyp from git as well.
allow-git=all
